# Copy this file to .env for local development.
# Replace every placeholder. Do not commit the copied file.

# Browser-visible Astro configuration
PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
PUBLIC_UPLOAD_ENDPOINT_URL=http://localhost:4321/api/upload
PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud

# Deployment values
# convex
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev
# node
UPLOADTHING_TOKEN=your-uploadthing-token
CONVEX_SITE_URL=https://your-development-deployment.convex.site
# convex and node (example: openssl rand -base64 32)
UPLOADTHING_CALLBACK_SECRET=generate-a-long-random-server-only-secret

# Optional error monitoring. Source maps are uploaded only when all three
# SENTRY_AUTH_TOKEN, SENTRY_ORG, and SENTRY_PROJECT are set during the build.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=

# Only local
