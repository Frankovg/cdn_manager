# Production template. Inject these values through the hosting provider or
# process environment; do not commit a populated .env.production file.

# Browser-visible values are embedded at build time
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-production-publishable-key
VITE_UPLOAD_ENDPOINT_URL=/api/upload
VITE_CONVEX_URL=https://your-production-deployment.convex.cloud

# Convex deployment/server values
CONVEX_DEPLOYMENT=your-production-deployment
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-production-instance.clerk.accounts.dev

# Upload server-only values
UPLOADTHING_TOKEN=your-uploadthing-production-token
CONVEX_SITE_URL=https://your-production-deployment.convex.site
UPLOADTHING_CALLBACK_SECRET=generate-a-long-random-server-only-secret
