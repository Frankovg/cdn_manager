    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
