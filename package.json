    "@internationalized/date": "^3.12.3",
    "@lucide/vue": "^1.29.0",
    "@sentry/astro": "^10.69.0",
    "@uploadthing/vue": "^7.3.3",
    "@vueuse/core": "^14.4.0",
    "astro": "^7.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "convex": "^1.38.0",
    "convex-vue": "^0.1.5",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.10.1",
    "tw-animate-css": "^1.4.0",
