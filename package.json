{
  "name": "cdn-assets-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "deploy": "convex deploy --cmd 'pnpm build'",
    "typecheck": "astro check",
    "lint": "oxlint . --ignore-pattern '.astro/**'",
    "test": "vitest run",
    "build": "pnpm run typecheck && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.0",
    "@astrojs/vue": "^7.0.2",
    "@clerk/vue": "^2.2.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/vue": "^1.29.0",
    "@sentry/astro": "^10.69.0",
    "@uploadthing/vue": "^7.3.3",
    "@vueuse/core": "^14.4.0",
    "astro": "^7.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.38.0",
    "convex-vue": "^0.1.5",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@altipla/oxlint-config": "^0.1.6",
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@vue/tsconfig": "^0.7.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
