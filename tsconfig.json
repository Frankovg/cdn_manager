{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "~/*": ["./src/*"],
      "~convex/*": ["./convex/*"],
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "*.ts", "scripts/**/*.ts", "convex/**/*", "docs/.vitepress/theme/*.ts", "./.nitro/types/nitro.d.ts"],
  "exclude": ["node_modules", "dist", ".output"]
}
